{
  "name": "unitree_g1_motion_mirror_v0_wall_clock",
  "description": "Wall-clock external Unitree G1 motion-capture mirroring benchmark scaffold.",
  "env_id": "external:mjlab:Unitree-G1-MotionMirror-v0",
  "env_kwargs": {
    "render_mode": "rgb_array",
    "robot": "unitree_g1",
    "task_id": "Mjlab-Tracking-Flat-Unitree-G1",
    "motion_family": "side_kick",
    "num_envs": 4096,
    "eval_num_envs": 1024,
    "steps_per_env_per_iteration": 24,
    "dry_run": false
  },
  "train_episodes": 1000000,
  "train_seconds": 300,
  "eval_episodes": 2,
  "max_steps": 500,
  "render_mode": "rgb_array",
  "primary_metric": "eval_avg_mpkpe",
  "primary_metric_mode": "minimize",
  "train_seed": 42,
  "eval_seed_start": 9000,
  "device": "external",
  "eval_case_bank": "eval_cases.json",
  "execution_backend": {
    "kind": "external",
    "name": "unitree_mjlab_g1_motion_mirror",
    "adapter": "autoresearch_gym.external.unitree_backend:UnitreeExternalBackend",
    "task_family": "g1_motion_mirror",
    "artifact_schema_version": 1,
    "supports_live_frame": true,
    "supports_sampled_trajectory": true,
    "policy_artifact": "torch_checkpoint",
    "execution_target": "local",
    "dry_run": false,
    "required_paths": [
      ".external/mjlab",
      ".external/unitree_rl_mjlab",
      "autoresearch_runs/source_motions/pbhc_side_kick_mjlab_motion.npz"
    ]
  }
}
